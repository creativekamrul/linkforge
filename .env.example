# LinkForge - copy to .env and edit. Never commit the real .env.

# Password for the dashboard at /admin. Leave empty to disable the dashboard.
ADMIN_PASSWORD=choose-a-long-password

# Secret used to sign the dashboard session cookie. Any long random string.
# Change it to invalidate all existing sessions.
AUTH_SECRET=change-me-to-a-long-random-string

# Where the site content lives (inside the container).
CONFIG_PATH=/app/data/site.json

# Public URL of the deployed site - used for OG tags, QR code, sitemap, robots.
SITE_URL=http://localhost:3000

# Host port mapping for docker compose.
PORT=3000
TZ=UTC
