# LinkForge - copy to .env and edit. Never commit the real .env.

# Password for the dashboard at /admin. Leave empty to disable the dashboard.
ADMIN_PASSWORD=choose-a-long-password

# Secret used to sign the dashboard session cookie. Any long random string.
# Change it to invalidate all existing sessions.
AUTH_SECRET=change-me-to-a-long-random-string

# Where the site content lives (inside the container).
CONFIG_PATH=/app/data/site.json

# The port the app listens on. This single value is used for the container port,
# the published host port, the app itself and its healthcheck - nothing is
# hardcoded, so set it to any free port on your host.
PORT=3000

# Public URL of the deployed site - used for OG tags, QR code, vCard, sitemap and
# robots. Set it to the address you actually browse, host and port included
# (for example http://192.168.0.206:8080). Falls back to site.url in the JSON.
SITE_URL=http://localhost:3000

# Container timezone.
TZ=UTC
